# Copy to .env and fill in values
GEMINI_API_KEY=
SMTP_USERNAME=
SMTP_PASSWORD=
RECIPIENT_EMAIL=

# Gmail API OAuth (Client ID/Secret only; no credentials.json)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Auth mode: localserver (default) or console (use console in headless prod)
GMAIL_AUTH_MODE=console
# Token file path (created on first auth)
GMAIL_TOKEN_FILE=token.json
GMAIL_REFRESH_TOKEN=

BRAND_LOGO_URL=